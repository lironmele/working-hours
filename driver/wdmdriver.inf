;
; wdmdriver.inf -- Installation file for the sample WDM driver.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Sample
ClassGuid   = {78A1C341-4539-11d3-B88D-00C04FAD5171}
Provider    = %ProviderName%
DriverVer   = 01/01/2024,1.0.0.0
CatalogFile = wdmdriver.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13 ; DIRID_DRIVERS

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
wdmdriver.sys = 1

; ================= Class section =====================

[ClassInstall32]
AddReg = SampleClass_RegistryAdd

[SampleClass_RegistryAdd]
HKR,,,,%ClassName%
HKR,,Icon,,-5

; ================= Device section =====================

[Manufacturer]
%ProviderName% = Standard,NT$ARCH$.10.0...16299

[Standard.NT$ARCH$.10.0...16299]
%DeviceDesc% = WdmDriver_Install, root\wdmdriver

[WdmDriver_Install.NT]
CopyFiles = WdmDriver_CopyFiles

[WdmDriver_CopyFiles]
wdmdriver.sys

[WdmDriver_Install.NT.Services]
AddService = wdmdriver, 0x00000002, WdmDriver_Service

[WdmDriver_Service]
DisplayName   = %ServiceDesc%
ServiceType   = 1 ; SERVICE_KERNEL_DRIVER
StartType     = 3 ; SERVICE_DEMAND_START
ErrorControl  = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\wdmdriver.sys

; ================= Strings =====================

[Strings]
ProviderName = "WDM Sample"
ClassName    = "Sample Device"
DiskName     = "WDM Driver Installation Disk"
DeviceDesc   = "WDM Sample Driver"
ServiceDesc  = "WDM Sample Driver Service"
